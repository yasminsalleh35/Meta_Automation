# Supabase Configuration (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Feature flags (optional; default off)
# VITE_FEATURE_ADVANCED_ANALYTICS=true   — exposes /dashboard/advanced-analytics (audit DATA-01: still uses estimated data)

# Backend secrets are NOT set here. They live in Supabase → Edge Functions → Secrets
# (CRON_SECRET, SITE_URL, PAGARME_*, RESEND_API_KEY, OPENAI/DEEPSEEK keys, ...) or in
# service-role-only DB config tables (Meta app, Asaas, Pagar.me, Stripe).
# Full list: docs/deployment-guide.md → "Function secrets".
